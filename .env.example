# ============================================================================
# Tuvoria — Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real secrets.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser; everything
# else is server-only and must never be referenced from client components.
# ============================================================================

# --- Application ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Tuvoria

# --- Supabase (Database, Auth, Storage) -------------------------------------
# Public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses Row Level Security — use ONLY in trusted server code
# (webhooks, admin service functions). Never import into client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Payments: Paystack -----------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret

# --- Payments: Stripe -------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Which provider platform billing uses by default: "paystack" | "stripe"
NEXT_PUBLIC_DEFAULT_PAYMENT_PROVIDER=paystack

# --- Email: Resend ----------------------------------------------------------
RESEND_API_KEY=re_xxx
EMAIL_FROM="Tuvoria <no-reply@tuvoria.app>"

# --- AI (future — provider-abstracted, optional) ----------------------------
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxx

# --- Observability (optional) -----------------------------------------------
# SENTRY_DSN=
